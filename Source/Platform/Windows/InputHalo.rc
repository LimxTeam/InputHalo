#pragma code_page(65001)
#include <Windows.h>
#include "Resources.h"
#include "ProductInfo.h"
IDI_INPUTHALO ICON "../../../Assets/Icons/InputHalo.ico"
1 VERSIONINFO
 FILEVERSION IH_FILE_VERSION
 PRODUCTVERSION IH_FILE_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG | VS_FF_PRERELEASE
#else
 FILEFLAGS VS_FF_PRERELEASE
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "080404b0"
  BEGIN
   VALUE "CompanyName", IH_COMPANY_ZH "\0"
   VALUE "FileDescription", IH_PRODUCT_NAME "\0"
   VALUE "FileVersion", IH_PRODUCT_VERSION ".0\0"
   VALUE "InternalName", "InputHalo\0"
   VALUE "OriginalFilename", "InputHalo.exe\0"
   VALUE "ProductName", IH_PRODUCT_NAME "\0"
   VALUE "ProductVersion", IH_PRODUCT_VERSION " Preview\0"
   VALUE "LegalCopyright", "Copyright (c) 2026 " IH_COMPANY_ZH "。保留所有权利。\0"
   VALUE "Comments", "由 LimxTeam 开发；专有商业软件。\0"
  END
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", IH_COMPANY_EN "\0"
   VALUE "FileDescription", IH_PRODUCT_NAME "\0"
   VALUE "FileVersion", IH_PRODUCT_VERSION ".0\0"
   VALUE "InternalName", "InputHalo\0"
   VALUE "OriginalFilename", "InputHalo.exe\0"
   VALUE "ProductName", IH_PRODUCT_NAME "\0"
   VALUE "ProductVersion", IH_PRODUCT_VERSION " Preview\0"
   VALUE "LegalCopyright", "Copyright (c) 2026 " IH_COMPANY_EN " All rights reserved.\0"
   VALUE "Comments", "Developed by LimxTeam. Proprietary commercial software.\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0804, 1200, 0x0409, 1200
 END
END
